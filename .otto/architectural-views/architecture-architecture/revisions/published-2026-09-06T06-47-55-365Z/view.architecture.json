  "cards": [
    {
      "dot": "cyan",
      "title": "Clients project the daemon",
      "items": [
        "Expo, Electron, and CLI clients are projections over one daemon, not independent implementations.",
        "packages/protocol carries the wire schemas; packages/client is the shared WebSocket SDK.",
        "The desktop host starts and supervises the daemon it connects to."
      ]
    },
    {
      "dot": "emerald",
      "title": "The daemon owns the system",
      "items": [
        "Agent lifecycles, workspaces, tools, durable host state, and the WebSocket API.",
        "OTTO_HOME holds host state; repository state stays in .otto knowledge, code, and git.",
        "packages/brain hosts local OpenAI-compatible models for the same daemon."
      ]
    },
    {
      "dot": "rose",
      "title": "Load-bearing boundaries",
      "items": [
        "Wire changes stay backward-compatible in both directions.",
        "New capabilities are provider-neutral by contract.",
        "Dev, agent, test, demo, and installed lanes use isolated ports and homes."
      ]
    }
  ]
