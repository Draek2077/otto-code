{
  "worktree": {
    "setup": [
      "npm ci",
      "node ./scripts/seed-ios-native-cache.mjs",
      "node ./scripts/seed-worktree-dev-state.mjs",
      "npm run build:server",
      "npm run build --workspace=@otto-code/expo-two-way-audio"
    ]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "OTTO_DEV_MANAGED_HOME=1 OTTO_DEV_ROOT=\"${OTTO_WORKTREE_PATH:-$PWD}\" OTTO_SKIP_DEV_SERVER_BUILD=1 OTTO_LISTEN=0.0.0.0:${OTTO_PORT:-6788} ./scripts/dev-daemon.sh"
    },
    "app": {
      "type": "service",
      "command": "OTTO_DEV_MANAGED_HOME=1 OTTO_DEV_ROOT=\"${OTTO_WORKTREE_PATH:-$PWD}\" OTTO_LISTEN=0.0.0.0:${OTTO_SERVICE_DAEMON_PORT:-6788} OTTO_DEV_DAEMON_ENDPOINT=localhost:${OTTO_SERVICE_DAEMON_PORT:-6788} EXPO_PORT=${OTTO_PORT:-} ./scripts/dev-app.sh"
    },
    "desktop": {
      "type": "service",
      "command": "OTTO_DEV_MANAGED_HOME=1 OTTO_DEV_ROOT=\"${OTTO_WORKTREE_PATH:-$PWD}\" OTTO_LISTEN=0.0.0.0:${OTTO_SERVICE_DAEMON_PORT:-6788} OTTO_DEV_DAEMON_ENDPOINT=localhost:${OTTO_SERVICE_DAEMON_PORT:-6788} EXPO_PORT=${OTTO_PORT:-} exec ./packages/desktop/scripts/dev.sh"
    },
    "ios-simulator": {
      "type": "service",
      "command": "OTTO_DEV_MANAGED_HOME=1 OTTO_DEV_ROOT=\"$PWD\" OTTO_LISTEN=0.0.0.0:${OTTO_SERVICE_DAEMON_PORT} OTTO_DEV_DAEMON_ENDPOINT=localhost:${OTTO_SERVICE_DAEMON_PORT} ./scripts/otto-ios-simulator-service.sh"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}
