{
  "name": "@getpaseo/plugin",
  "version": "0.9.35",
  "description": "Paseo plugin SDK package",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "source": "./src/server/index.ts",
      "default": "./dist/server/index.js"
    },
    "./server/provider": {
      "types": "./dist/server/provider.d.ts",
      "source": "./src/server/provider.ts",
      "default": "./dist/server/provider.js"
    },
    "./server/otto-openai": {
      "types": "./dist/server/otto-openai.d.ts",
      "source": "./src/server/otto-openai.ts",
      "default": "./dist/server/otto-openai.js"
    },
    "./server/otto-brain": {
      "types": "./dist/server/otto-brain.d.ts",
      "source": "./src/server/otto-brain.ts",
      "default": "./dist/server/otto-brain.js"
    },
    "./server/otto-kanban": {
      "types": "./dist/server/otto-kanban.d.ts",
      "source": "./src/server/otto-kanban.ts",
      "default": "./dist/server/otto-kanban.js"
    },
    "./otto/kanban": {
      "types": "./dist/otto/kanban.d.ts",
      "source": "./src/otto/kanban.ts",
      "default": "./dist/otto/kanban.js"
    },
    "./otto/atlassian-settings": {
      "types": "./dist/otto/atlassian-settings.d.ts",
      "source": "./src/otto/atlassian-settings.ts",
      "default": "./dist/otto/atlassian-settings.js"
    },
    "./otto/project-knowledge": {
      "types": "./dist/otto/project-knowledge.d.ts",
      "source": "./src/otto/project-knowledge.ts",
      "default": "./dist/otto/project-knowledge.js"
    },
    "./otto/openai-settings": {
      "types": "./dist/otto/openai-settings.d.ts",
      "source": "./src/otto/openai-settings.ts",
      "default": "./dist/otto/openai-settings.js"
    },
    "./server/usage": {
      "types": "./dist/server/usage.d.ts",
      "source": "./src/server/usage.ts",
      "default": "./dist/server/usage.js"
    },
    "./server/acp": {
      "types": "./dist/server/acp.d.ts",
      "source": "./src/server/acp.ts",
      "default": "./dist/server/acp.js"
    },
    "./client/react-native": {
      "types": "./dist/client/react-native.d.ts",
      "source": "./src/client/react-native.ts",
      "default": "./dist/client/react-native.js"
    },
    "./client/host": {
      "types": "./dist/client/host.d.ts",
      "source": "./src/client/host.ts",
      "default": "./dist/client/host.js"
    },
    "./client/ui": {
      "types": "./dist/client/ui.d.ts",
      "source": "./src/client/ui.ts",
      "default": "./dist/client/ui.js"
    },
    "./client/otto-brain": {
      "types": "./dist/client/otto-brain.d.ts",
      "source": "./src/client/otto-brain.ts",
      "default": "./dist/client/otto-brain.js"
    },
    "./client/otto-knowledge": {
      "types": "./dist/client/otto-knowledge.d.ts",
      "source": "./src/client/otto-knowledge.ts",
      "default": "./dist/client/otto-knowledge.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "source": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    },
    "./otto/browser-history": {
      "types": "./dist/otto/browser-history.d.ts",
      "source": "./src/otto/browser-history.ts",
      "default": "./dist/otto/browser-history.js"
    },
    "./otto/context-management": {
      "types": "./dist/otto/context-management.d.ts",
      "source": "./src/otto/context-management.ts",
      "default": "./dist/otto/context-management.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.examples.json --noEmit",
    "typecheck:otto-fixtures": "tsgo -p tsconfig.otto-tests.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@getpaseo/brain": "0.9.35",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.35",
    "@getpaseo/protocol": "0.9.35",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@getpaseo/client": "0.9.35",
    "@getpaseo/protocol": "0.9.35",
    "react": "~19.1.0",
    "react-native": ">=0.81.5",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
