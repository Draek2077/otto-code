{
  "name": "@otto-code/auth-service",
  "version": "0.9.24",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging --local-protocol https --ip 127.0.0.1 --port 8793 --var PUBLIC_ORIGIN:https://127.0.0.1:8793",
    "typecheck": "tsgo --noEmit",
    "build": "wrangler deploy --dry-run --env staging --outdir dist",
    "build:production": "wrangler deploy --dry-run --env production --outdir dist",
    "test:runtime": "node scripts/smoke.mjs && node scripts/smoke.mjs hubspot",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "miniflare": "4.20260507.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.75.0"
  }
}
