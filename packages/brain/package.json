{
  "name": "@otto-code/brain",
  "version": "0.8.15",
  "description": "Otto Brain - self-contained host for local GGUF models, with measured VRAM budgeting and reasoning-budget control",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "otto-brain": "bin/otto-brain"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "node": "./dist/cli.js",
      "import": "./src/cli.ts",
      "default": "./src/cli.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "selfsigned": "^2.4.1",
    "yaml": "^2.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
